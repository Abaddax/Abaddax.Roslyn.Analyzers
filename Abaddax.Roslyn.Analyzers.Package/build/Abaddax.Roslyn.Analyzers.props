<Project>

  <!-- Make options visable to analyzers -->
  <ItemGroup>
    <CompilerVisibleProperty Include="AbaddaxRoslynAnalyzersABX0001IgnoreTests" />
    <CompilerVisibleProperty Include="AbaddaxRoslynAnalyzersABX0002IgnoreControllers" />
    <CompilerVisibleProperty Include="AbaddaxRoslynAnalyzersABX0002IgnoreTests" />
    <CompilerVisibleProperty Include="AbaddaxRoslynAnalyzersABX1001Enabled" />
    <CompilerVisibleProperty Include="AbaddaxRoslynAnalyzersABX1002Enabled" />
    <CompilerVisibleProperty Include="AbaddaxRoslynAnalyzersABX1003Enabled" />
  </ItemGroup>

</Project>
